# KankorPrep production environment template.
# Copy to .env.production locally or configure the equivalent variables in the hosting providers.
# Never commit real production credentials.

NODE_ENV=production

DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/DB?sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

API_HOST=0.0.0.0
API_PORT=4000

# Enable only when deployed behind a trusted reverse proxy.
TRUST_PROXY=false

# Public HTTPS API URL embedded into the mobile release build.
EXPO_PUBLIC_API_URL=https://api.example.com

# Public HTTPS API URL embedded into the admin production build.
NEXT_PUBLIC_API_URL=https://api.example.com

# Exact HTTPS admin web origin(s), comma-separated when more than one is required.
ADMIN_WEB_ORIGIN=https://admin.example.com

# Must be empty for final production release after permanent roles are assigned.
ADMIN_BOOTSTRAP_EMAILS=

# Must remain false in production.
AUTH_EXPOSE_RECOVERY_TOKEN=false

# Set a strong secret when the production billing webhook is enabled.
BILLING_WEBHOOK_SECRET=REPLACE_WITH_A_STRONG_SECRET
