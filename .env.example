# Pooled connection for normal application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/DB?sslmode=require

# Direct Neon connection for Drizzle migrations. Recommended for schema changes.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

API_HOST=0.0.0.0
API_PORT=4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Development only. When true, password-recovery requests return the raw reset token.
# Never enable in production.
AUTH_EXPOSE_RECOVERY_TOKEN=false
NODE_ENV=development
