{
  "name": "kankorprep",
  "version": "0.9.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace @kankor/mobile run start",
    "dev:admin": "npm --workspace @kankor/admin run dev",
    "dev:api": "npm --workspace @kankor/api run dev",
    "build:admin": "npm --workspace @kankor/admin run build",
    "build:api": "npm --workspace @kankor/api run build",
    "db:migrate": "npm --workspace @kankor/database run db:migrate",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "verify:history-g10": "node scripts/verify-history-grade10.mjs",
    "db:seed:test-questions": "npm --workspace @kankor/database run db:seed:test-questions",
    "db:setup:test-content": "npm run db:migrate && npm run db:seed:test-questions",
    "verify:grade10-test-content": "node scripts/verify-grade10-test-content.mjs",
    "verify:phase6": "node scripts/verify-phase6.mjs",
    "verify:phase7": "node scripts/verify-phase7.mjs",
    "verify:phase8": "node scripts/verify-phase8.mjs",
    "verify:phase9": "node scripts/verify-phase9.mjs",
    "verify:rtl": "node scripts/verify-mobile-rtl.mjs",
    "verify:grade10-four-books": "node scripts/verify-grade10-four-books.mjs",
    "verify:grade11-five-books": "node scripts/verify-grade11-five-books.mjs",
    "verify:grade11-remaining-books": "node scripts/verify-grade11-remaining-books.mjs",
    "verify:grade11-tafseer-auth": "node scripts/verify-grade11-tafseer-auth.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
