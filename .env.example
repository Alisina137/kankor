# Pooled connection for normal application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/DB?sslmode=require

# Direct Neon connection for database migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

API_HOST=0.0.0.0
API_PORT=4000
# For a physical phone, replace localhost with the laptop Wi-Fi IPv4 address (for example http://10.50.2.130:4000).\n# Expo mobile config reads this value from the repository-root .env.\nEXPO_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
ADMIN_WEB_ORIGIN=http://localhost:3000

# Comma-separated existing account emails allowed to bootstrap content administration.
# Keep empty in production after permanent roles are assigned.
ADMIN_BOOTSTRAP_EMAILS=

# Development only. When true, password-recovery requests return the raw reset token.
# Never enable in production.
AUTH_EXPOSE_RECOVERY_TOKEN=false
NODE_ENV=development
