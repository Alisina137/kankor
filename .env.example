# KankorPrep local/development environment template.
# Copy to .env and replace placeholders. Never commit real secrets.

# Pooled connection for normal application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/DB?sslmode=verify-full

# Direct Neon connection for database migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

API_HOST=0.0.0.0
API_PORT=4000

# Set true only when the API is behind a trusted reverse proxy that supplies client IP headers.
TRUST_PROXY=false

# Keep localhost as the stable development default. On a physical phone,
# the app derives the current Expo/LAN host automatically.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional comma-separated fallbacks for places where the laptop commonly
# receives known addresses. Example: company + home Wi-Fi.
# EXPO_PUBLIC_API_URLS=http://10.10.10.200:4000,http://10.50.2.130:4000
EXPO_PUBLIC_API_URLS=

# Admin web app API endpoint.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Comma-separated exact admin web origins allowed by API CORS.
ADMIN_WEB_ORIGIN=http://localhost:3000

# Comma-separated existing account emails allowed to bootstrap content administration.
# Keep empty in production after permanent roles are assigned.
ADMIN_BOOTSTRAP_EMAILS=

# Development only. When true, password-recovery requests return the raw reset token.
# Never enable in production.
AUTH_EXPOSE_RECOVERY_TOKEN=false

# Required only when the production billing webhook is enabled.
BILLING_WEBHOOK_SECRET=

# Optional in local development; required before production if profile-photo upload is enabled.
# Works with AWS S3 or an S3-compatible provider.
PROFILE_PHOTO_S3_BUCKET=
PROFILE_PHOTO_S3_REGION=
PROFILE_PHOTO_S3_ENDPOINT=
PROFILE_PHOTO_S3_ACCESS_KEY_ID=
PROFILE_PHOTO_S3_SECRET_ACCESS_KEY=
PROFILE_PHOTO_S3_FORCE_PATH_STYLE=false

NODE_ENV=development
