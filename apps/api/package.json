{
  "name": "@kankor/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --workspace @kankor/database run build && tsx watch src/server.ts",
    "build": "npm --workspace @kankor/database run build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "npm --workspace @kankor/database run build && tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@kankor/database": "*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2"
  }
}
