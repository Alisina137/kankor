{
  "name": "@kankor/mobile",
  "version": "0.4.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "check:expo": "npx expo install --check",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production"
  },
  "dependencies": {
    "@kankor/config": "*",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2",
    "@expo/ngrok": "^4.1.0"
  }
}
